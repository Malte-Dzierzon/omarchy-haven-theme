# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#070e15"

# Main text color
theme[main_fg]="#e9efeb"

# Title color for boxes
theme[title]="#e9efeb"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#97a6bb"

# Background color of selected item in processes box. #20262c maps to
# the foreground role in aether (terminal selection wants inverted contrast),
# which renders as plain white on dark themes - indistinguishable from the
# main text. #20262c gives a subtle highlight that still reads on a
# dark background and is invisible-but-harmless on light backgrounds.
theme[selected_bg]="#20262c"

# Foreground color of selected item in processes box. Use #e9efeb so
# the row text stays readable on the lighter_bg highlight; the previous
# #97a6bb produced low-contrast blue-on-white in dark themes.
theme[selected_fg]="#e9efeb"

# Color of inactive/disabled text
theme[inactive_fg]="#62676c"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling.
# #eff3ef caps at #ffffff when the foreground is already pure white, so we
# just bind it to #e9efeb directly.
theme[graph_text]="#e9efeb"

# Background color of the percentage meters. Same fix as selected_bg - the
# previous #20262c collapsed to the main fg.
theme[meter_bg]="#20262c"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text.
# Use #83a2a3 for a distinct accent instead of #eff3ef which capped to white.
theme[proc_misc]="#83a2a3"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#6c7b91"
theme[mem_box]="#82967f"
theme[net_box]="#857960"
theme[proc_box]="#97a6bb"

# Box divider line and small boxes line color
theme[div_line]="#62676c"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#82967f"
theme[temp_mid]="#96937b"
theme[temp_end]="#857960"

# CPU graph colors (Teal -> Blue -> Purple)
theme[cpu_start]="#83a2a3"
theme[cpu_mid]="#97a6bb"
theme[cpu_end]="#6c7b91"

# Mem/Disk free meter
theme[free_start]="#6c7b91"
theme[free_mid]="#97a6bb"
theme[free_end]="#83a2a3"

# Mem/Disk cached meter
theme[cached_start]="#97a6bb"
theme[cached_mid]="#83a2a3"
theme[cached_end]="#6c7b91"

# Mem/Disk available meter
theme[available_start]="#96937b"
theme[available_mid]="#857960"
theme[available_end]="#857960"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#82967f"
theme[used_mid]="#83a2a3"
theme[used_end]="#97a6bb"

# Download graph colors
theme[download_start]="#96937b"
theme[download_mid]="#857960"
theme[download_end]="#857960"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#82967f"
theme[upload_mid]="#83a2a3"
theme[upload_end]="#97a6bb"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#83a2a3"
theme[process_mid]="#97a6bb"
theme[process_end]="#6c7b91"
